{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "background": "#f3e600",
          "foreground": "#000000",
          "properties": {
            "style": "austin",
            "threshold": 321
          },
          "style": "plain",
          "template": " {{ .FormattedMs }} ",
          "type": "executiontime"
        },
        {
          "background": "#880000",
          "foreground": "c5003c",
          "style": "plain",
          "template": "{{ if gt .Code 0 }} {{ .Code }} {{ end }}",
          "type": "status"
        },
        {
          "background": "#ffcc88",
          "foreground": "#222222",
          "style": "plain",
          "template": "\uf0e7",
          "type": "root"
        },
        {
          "background": "",
          "foreground": "#f3e600",
          "style": "powerline",
          "trailing_diamond": "",
          "foreground_templates": [
            "{{ if .Env.CONTAINER_ID }}#ff5555{{ end }}"
          ],
          "template": "{{ if .SSHSession }}\ueba9 {{ end }}{{ if .Env.CONTAINER_ID }} \uf487  {{ .Env.CONTAINER_ID }}@{{ else }} \udb80\udc01  {{ end }}{{ .HostName }} ",
          "type": "session"
        },
        {
          "background": "",
          "foreground": "#55ead4",
          "properties": {
            "folder_icon": "\uea7c",
            "style": "full"
          },
          "style": "powerline",
          "powerline_symbol": "",
          "template": "{{ if and (ne .Path \"/\") (ne .Path \"~\")}} {{ .Path }} {{ else }} {{ .Path }} {{ end }}",
          "type": "path"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "right",
      "newline": false,
      "segments": [
        {
          "background": "",
          "foreground": "#f3e600",
          "properties": {
            "branch_icon": "\ue725 ",
            "cherry_pick_icon": "\ue29b ",
            "commit_icon": "\uf417 ",
            "fetch_status": false,
            "fetch_upstream_icon": false,
            "merge_icon": "\ue727 ",
            "no_commits_icon": "\uf0c3 ",
            "rebase_icon": "\ue728 ",
            "revert_icon": "\uf0e2 ",
            "tag_icon": "\uf412 "
          },
          "style": "plain",
          "template": " {{ .HEAD }} ",
          "type": "git"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "foreground": "#55ead4",
      "newline": true,
      "segments": [
        {
          "foreground": "#55ead4",
          "style": "plain",
          "template": "{{ .Name }} ",
          "type": "shell",
          "properties": {
            "mapped_shell_names": {
              "pwsh": "\u276f",
              "shell": "\u276f",
              "cmd": ">",
              "lua": ">",
              "nu": ":)",
              "fish": "~>",
              "zsh": "%",
              "bash": "$"
            }
          }
        }
      ],
      "type": "prompt"
    }
  ],
  "version": 2
}
